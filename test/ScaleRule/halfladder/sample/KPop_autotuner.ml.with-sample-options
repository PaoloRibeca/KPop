(* THE NUMBER OF AXES A ROUND WORKS IN: a fixed number, 0 taking as many as the analysis yields, or
   [Auto], which lets the valleys choose it afresh at every round *)
module Dimensions =
  struct
    type t =
      | Auto
      | Fixed of int
    let of_string = function
      | "auto" -> Auto
      | s ->
        match int_of_string_opt s with
        | Some d when d >= 0 -> Fixed d
        | _ -> Exception.raise_unrecognized_initializer __FUNCTION__ "number of dimensions" s
    let to_string = function
      | Auto -> "auto"
      | Fixed d -> string_of_int d
  end

(* How a later round's sample of spectra is chosen with the partition: how the budget is shared
   among the classes, and which members stand for a class *)
module PartitionSample =
  struct
    module Allocation =
      struct
        type t =
          | EveryClass
          | BySize
        let of_string = function
          | "every-class" -> EveryClass
          | "by-size" -> BySize
          | s -> Exception.raise_unrecognized_initializer __FUNCTION__ "partition sample allocation" s
        let to_string = function
          | EveryClass -> "every-class"
          | BySize -> "by-size"
      end
    module Members =
      struct
        type t =
          | Extremes
          | AtRandom
        let of_string = function
          | "extremes" -> Extremes
          | "random" -> AtRandom
          | s -> Exception.raise_unrecognized_initializer __FUNCTION__ "partition sample members" s
        let to_string = function
          | Extremes -> "extremes"
          | AtRandom -> "random"
      end
  end

