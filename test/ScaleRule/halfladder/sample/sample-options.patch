+# ----------------------------------------------------------------------------
+# Part 4: how a later round's sample is chosen with the partition
+# ----------------------------------------------------------------------------
+echo
+echo "=== Part 4: --partition-sample-allocation and --partition-sample-members ==="
+"$BIN" -i "$DATA" -o "$TMP/s" "${FLAGS[@]}" --partition-sample 50 --partition-sample-allocation by-size \
+  --partition-sample-members random > "$TMP/s.stdout" 2> "$TMP/s.stderr"
+rc=$?
+if [[ $rc -eq 0 && "$(grep -c '^=== Clustering' "$TMP/s.stdout")" -ge 2 ]]; then
+  pass "a sample shared by size, members at random, runs its rounds"
+else
+  fail "a sample shared by size, members at random, runs its rounds" \
+    "exit status $rc; $(tail -n 1 "$TMP/s.stderr")"
+fi
+refused "an allocation of no known kind is refused" \
+  "Unrecognized partition sample allocation 'evenly'" --partition-sample-allocation evenly
+refused "members of no known kind are refused" \
+  "Unrecognized partition sample members 'best'" --partition-sample-members best
+
 echo
 if [[ $failed -eq 0 ]]; then
   echo "All autotuner integration tests passed."
