#!/usr/bin/env bash

# silh-run -- the silhouette against the number of axes, on the eight embeddings of the axis-ladder page
#
#   silh-run <output_directory>
#
# Compiles room-build/silh.ml and runs it over the six full-corpus embeddings and the two
# 300-sequence ones, at every rung of the half-powers ladder and at the most axes there are, with the
# rung the half-powers ladder picked as the partition carried to every rung.  One job at a time,
# nice 19.

set -u

OUT="${1:?usage: silh-run <output_directory>}"
T=/home/ribeca/.claude/jobs/29a54aa8/tmp
B="$T/stage1/room-build"
C="$T/collapse/real-data"
V="$T/simpson/vp2"
SM="$T/stage1/small"
L=/home/ribeca/Development/Git/NailIt/test/data/denovo
H=/home/ribeca/Development/Git/KPop.Claude/test/ScaleRule/halfladder
HALF=1,2,3,4,6,8,11,16,23,32,45,64,91,128,181

mkdir -p "$OUT"
( cd "$B" && nice -n 19 ocamlfind ocamlopt -O3 -unsafe -package unix -linkpkg kio.ml silh.ml -o silh \
    > "$OUT/compile.log" 2>&1 ) || { echo "compile failed"; cat "$OUT/compile.log"; exit 1; }
xz -dc "$H/half.cand.xz" > "$OUT/half.cand"
xz -dc "$H/small/small.cand.xz" > "$OUT/small.cand"

one() {
  local tag="$1" tw="$2" iv="$3" labels="$4" cand="$5" pick="$6" avail="$7"
  local start=$SECONDS
  nice -n 19 "$B/silh" "$tw" "$iv" "$labels" "$tag" "$cand" "$pick" "$HALF,$avail" > "$OUT/$tag.tsv" \
    2> "$OUT/$tag.err"
  echo "$tag exit=$? $(( SECONDS - start ))s"
}

one vp1s300 "$SM/vp1s300.T_rand.all.KPopTwisted.txt" "$SM/vp1s300.T_rand.all.KPopInertia.txt" \
  "$T/stage1/subsample/labels/vp1s300.cdc" "$OUT/small.cand" 16 67
one rdrps300 "$SM/rdrps300.T_rand.all.KPopTwisted.txt" "$SM/rdrps300.T_rand.all.KPopInertia.txt" \
  "$T/stage1/subsample/labels/rdrps300.cdc" "$OUT/small.cand" 3 67
one vp1.T_rand "$C/vp1.T_rand.all.KPopTwisted.txt" "$C/vp1.T_rand.all.KPopInertia.txt" "$L/vp1.cdc" "$OUT/half.cand" 23 243
one vp1.T_strat "$C/vp1.T_strat.all.KPopTwisted.txt" "$C/vp1.T_strat.all.KPopInertia.txt" "$L/vp1.cdc" "$OUT/half.cand" 23 243
one vp1.T_core "$C/vp1.T_core.all.KPopTwisted.txt" "$C/vp1.T_core.all.KPopInertia.txt" "$L/vp1.cdc" "$OUT/half.cand" 16 243
one rdrp.T_rand "$C/rdrp.T_rand.all.KPopTwisted.txt" "$C/rdrp.T_rand.all.KPopInertia.txt" "$L/rdrp.cdc" "$OUT/half.cand" 4 199
one rdrp.T_strat "$C/rdrp.T_strat.all.KPopTwisted.txt" "$C/rdrp.T_strat.all.KPopInertia.txt" "$L/rdrp.cdc" "$OUT/half.cand" 4 199
one vp2.T_rand "$V/vp2.T_rand.all.KPopTwisted.txt" "$V/vp2.T_rand.all.KPopInertia.txt" "$L/vp2.cdc" "$OUT/half.cand" 16 219
